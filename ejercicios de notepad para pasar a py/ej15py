def main():
	dinero = float(input("Introduce el dinero ingresado en la cuenta de ahorros con intereses: "))
	
	año_1 = dinero * 1.04
	año_2 = año_1 * 1.04
	año_3 = año_2 * 1.04
	
	print(f"el dinero que introduciste ({dinero}$), tras el primer año en la cuenta de ahorro será de {año_1:.2f}$, tras el segundo año sera de {año_2:.2f}$ y tras el tercer año será de {año_3:.2f}$.")
if __name__ == "__main__":
	main()