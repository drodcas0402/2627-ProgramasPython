def main():
	número = int(input("Introduce un número a sumar desde 1: "))
	
	número_1 = 1
	número_2 = 0
	suma = (número * (número + 1)) // 2
	
	while número >= número_1:
		número_2 = número_1 + número_2
		número_1 = número_1 + 1
		
	if suma == número_2:	
		print(f"El número introducido sumado por todos los enteros antes de él tendra como resultado {número_2}")
if __name__ == "__main__":
	main()